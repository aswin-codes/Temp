# Local dev: copy to .env.local and fill in. Production: set in the Vercel project.

# Resend. "Notify me" sign-ups are emailed by src/app/api/notify/route.ts.
RESEND_API_KEY=
# Team recipient(s), comma-separated: a@x.com, b@y.com
OTAKU_NOTIFY_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "Otaku Bharat <hello@otakubharat.com>".
# Blank uses Resend's shared onboarding@resend.dev, which only delivers to the
# Resend account owner's own address.
OTAKU_NOTIFY_FROM_EMAIL=
